{
  "name": "@maycombhq/ui",
  "version": "2.0.0-rc.1",
  "description": "The Atticus app: the screens the local server serves, built against the local API (C4).",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist-lib/index.js",
  "types": "./dist-lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/index.d.ts",
      "import": "./dist-lib/index.js"
    }
  },
  "files": [
    "dist",
    "dist-lib"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.shared.mjs --fsModuleCachePath=node_modules/.vitest-cache --testTimeout=30000"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-sans": "^5.2.0",
    "@fontsource/jetbrains-mono": "^5.2.0",
    "@fontsource/rajdhani": "^5.2.0",
    "@maycombhq/core": "workspace:*",
    "@maycombhq/diagrams": "workspace:*",
    "@playwright/test": "1.56.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.4",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@xyflow/react": "12.3.6",
    "elkjs": "0.9.3"
  }
}
