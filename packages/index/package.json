{
  "name": "@maycombhq/index",
  "version": "2.0.0-beta.9",
  "private": true,
  "description": "The local SQLite index over catalog files, the catalog query language, graph and impact.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.shared.mjs --fsModuleCachePath=node_modules/.vitest-cache --testTimeout=30000 --hookTimeout=60000"
  },
  "dependencies": {
    "@maycombhq/ai": "workspace:*",
    "@maycombhq/core": "workspace:*",
    "@maycombhq/ingestors": "workspace:*",
    "@maycombhq/intake": "workspace:*",
    "yaml": "^2.9.1"
  },
  "optionalDependencies": {
    "@maycombhq/embed": "workspace:*"
  }
}
