{
  "name": "@maycombhq/ingestors",
  "version": "2.0.0-beta.1",
  "description": "Reads Lucidchart, Visio and Mermaid diagrams, images, documents and Figma links into source documents, diagrams and text, for intake and reconcile.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.shared.mjs --fsModuleCachePath=node_modules/.vitest-cache --testTimeout=30000 --hookTimeout=60000"
  },
  "dependencies": {
    "@maycombhq/core": "workspace:*",
    "@maycombhq/reconcile": "workspace:*",
    "@maycombhq/sdk": "workspace:*",
    "yaml": "^2.9.1"
  }
}
