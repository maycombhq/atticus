{
  "name": "@maycombhq/taskrun",
  "version": "2.0.0-beta.9",
  "private": true,
  "description": "Run with AI: one task of a change at plan-only, draft or PR level, in hand-off, model or headless Claude Code mode, with build-fix attempts and run summaries.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "rules"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.shared.mjs --fsModuleCachePath=node_modules/.vitest-cache --testTimeout=30000 --hookTimeout=60000"
  },
  "dependencies": {
    "@maycombhq/adapters": "workspace:*",
    "@maycombhq/ai": "workspace:*",
    "@maycombhq/changes": "workspace:*",
    "@maycombhq/core": "workspace:*",
    "@maycombhq/naysayer": "workspace:*",
    "@maycombhq/planner": "workspace:*",
    "@maycombhq/scanner": "workspace:*",
    "@maycombhq/speckit": "workspace:*",
    "@maycombhq/testgen": "workspace:*",
    "@maycombhq/workspace": "workspace:*",
    "yaml": "^2.9.1",
    "zod": "^4.6.0"
  }
}
