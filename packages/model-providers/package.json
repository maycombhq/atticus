{
  "name": "@maycombhq/model-providers",
  "version": "2.0.0-beta.2",
  "private": true,
  "description": "Model-provider plugins for Atticus model mode (ADR 0065): Anthropic Messages, OpenAI-compatible Chat Completions (with Azure OpenAI) and AWS Bedrock Converse, through a corporate proxy and custom CA.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.shared.mjs --fsModuleCachePath=node_modules/.vitest-cache --testTimeout=30000 --hookTimeout=60000"
  },
  "dependencies": {
    "@maycombhq/ai": "workspace:*",
    "@maycombhq/core": "workspace:*",
    "undici": "^7.30.1"
  }
}
