{
  "name": "@maycombhq/knowledge",
  "version": "1.0.0-rc.1",
  "description": "Read-only knowledge sources (wikis), facts mapped from them, the integration pattern scan, coverage, freshness and owner questions for knowledge gaps.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.shared.mjs --fsModuleCachePath=node_modules/.vitest-cache --testTimeout=30000 --hookTimeout=60000"
  },
  "dependencies": {
    "@maycombhq/ai": "workspace:*",
    "@maycombhq/core": "workspace:*",
    "@maycombhq/features": "workspace:*",
    "@maycombhq/reconcile": "workspace:*",
    "yaml": "^2.9.1"
  }
}
