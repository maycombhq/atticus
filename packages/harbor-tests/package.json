{
  "name": "@maycombhq/harbor-tests",
  "version": "0.0.0",
  "private": true,
  "description": "Runs the pipeline (scan, intake, reconcile, knowledge, features, critic) on Harbor, the second reference ecosystem, and compares it with the hand-written expected files.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --fsModuleCachePath=node_modules/.vitest-cache --testTimeout=120000 --hookTimeout=120000"
  },
  "dependencies": {
    "@maycombhq/core": "workspace:*",
    "@maycombhq/extractors": "workspace:*",
    "@maycombhq/features": "workspace:*",
    "@maycombhq/ingestors": "workspace:*",
    "@maycombhq/intake": "workspace:*",
    "@maycombhq/knowledge": "workspace:*",
    "@maycombhq/naysayer": "workspace:*",
    "@maycombhq/reconcile": "workspace:*",
    "@maycombhq/scanner": "workspace:*",
    "@maycombhq/workspace": "workspace:*",
    "yaml": "^2.9.1"
  }
}
