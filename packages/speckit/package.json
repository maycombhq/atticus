{
  "name": "@maycombhq/speckit",
  "version": "2.0.0-beta.6",
  "private": true,
  "description": "The Spec Kit layer (ADR 0030): hand-down of a task into a repo's Spec Kit feature, hand-up, the generated constitution and the three-way drift check.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "rules"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.shared.mjs --fsModuleCachePath=node_modules/.vitest-cache --testTimeout=30000 --hookTimeout=60000"
  },
  "dependencies": {
    "@maycombhq/adapters": "workspace:*",
    "@maycombhq/ai": "workspace:*",
    "@maycombhq/assistant-files": "workspace:*",
    "@maycombhq/changes": "workspace:*",
    "@maycombhq/core": "workspace:*",
    "@maycombhq/extractors": "workspace:*",
    "@maycombhq/naysayer": "workspace:*",
    "@maycombhq/sdk": "workspace:*",
    "@maycombhq/workspace": "workspace:*",
    "yaml": "^2.9.1"
  }
}
