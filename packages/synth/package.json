{
  "name": "@maycombhq/synth",
  "version": "0.0.0",
  "private": true,
  "description": "Generates a synthetic estate of many Forge-style repos, with known answers, for scale tests.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.shared.mjs --fsModuleCachePath=node_modules/.vitest-cache --testTimeout=30000 --hookTimeout=60000"
  },
  "dependencies": {
    "@maycombhq/core": "workspace:*"
  },
  "devDependencies": {
    "@maycombhq/sdk": "workspace:*",
    "yaml": "^2.9.1"
  }
}
