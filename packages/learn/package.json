{
  "name": "@maycombhq/learn",
  "version": "2.0.0-beta.4",
  "private": true,
  "description": "Learning tools: role lessons as data with verifiable checks, a throwaway practice sandbox built from the Forge fixture, local progress, and plain-words explanations of records, findings and commands.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "lessons"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.shared.mjs --fsModuleCachePath=node_modules/.vitest-cache --testTimeout=60000 --hookTimeout=60000"
  },
  "dependencies": {
    "@maycombhq/adapters": "workspace:*",
    "@maycombhq/ai": "workspace:*",
    "@maycombhq/changes": "workspace:*",
    "@maycombhq/core": "workspace:*",
    "@maycombhq/scanner": "workspace:*",
    "yaml": "^2.9.1",
    "zod": "^4.6.0"
  }
}
