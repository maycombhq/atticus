{
  "name": "@maycombhq/glossary",
  "version": "2.0.0-beta.2",
  "private": true,
  "description": "The business glossary: terms from wiki pages, code and people, links to columns, schema fields and features, conflicts and synonyms.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.shared.mjs --fsModuleCachePath=node_modules/.vitest-cache --testTimeout=30000 --hookTimeout=60000"
  },
  "dependencies": {
    "@maycombhq/ai": "workspace:*",
    "@maycombhq/core": "workspace:*",
    "@maycombhq/knowledge": "workspace:*",
    "yaml": "^2.9.1",
    "zod": "^4.6.0"
  }
}
