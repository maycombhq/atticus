{
  "name": "@maycombhq/verify",
  "version": "2.0.0-beta.1",
  "description": "The verifier for the facts an assistant writes (ADR 0124): the claim on the cited line, the quote, references, redaction and coverage; and the map rendered from the catalog they become (map.md, flows, OpenAPI).",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.shared.mjs --fsModuleCachePath=node_modules/.vitest-cache --testTimeout=30000 --hookTimeout=60000"
  },
  "dependencies": {
    "@maycombhq/core": "workspace:*",
    "@maycombhq/diagrams": "workspace:*",
    "@maycombhq/sdk": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
