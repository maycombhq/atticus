{
  "name": "@maycombhq/release",
  "version": "2.0.0-beta.1",
  "description": "Generated views of a change for releasing it: the deployment plan, the forecast, the evidence pack, release notes, outcomes and the security review draft. Computed from the change folder, the catalog and the org pack on every read, so they never go stale.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.shared.mjs --fsModuleCachePath=node_modules/.vitest-cache --testTimeout=30000"
  },
  "dependencies": {
    "@maycombhq/adapters": "workspace:*",
    "@maycombhq/ai": "workspace:*",
    "@maycombhq/changes": "workspace:*",
    "@maycombhq/core": "workspace:*",
    "@maycombhq/initiatives": "workspace:*",
    "@maycombhq/intake": "workspace:*",
    "@maycombhq/naysayer": "workspace:*",
    "@maycombhq/planner": "workspace:*",
    "@maycombhq/testgen": "workspace:*",
    "@maycombhq/workspace": "workspace:*",
    "yaml": "^2.9.1",
    "zod": "^4.6.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
