{
  "name": "@maycombhq/sdk",
  "version": "2.0.0-beta.9",
  "description": "Atticus plugin SDK (contract C4): interfaces for extractors, dialects, ingestors and adapters.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "npm"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/bundle/npm-sdk.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.shared.mjs --fsModuleCachePath=node_modules/.vitest-cache --testTimeout=30000 --hookTimeout=60000",
    "prepack": "node ../../scripts/bundle/pack-manifest.mjs strip",
    "postpack": "node ../../scripts/bundle/pack-manifest.mjs restore"
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@maycombhq/core": "workspace:*"
  },
  "atticusBundled": true,
  "publishConfig": {
    "access": "public",
    "main": "./npm/index.js",
    "types": "./npm/index.d.ts",
    "exports": {
      ".": {
        "types": "./npm/index.d.ts",
        "import": "./npm/index.js"
      }
    }
  }
}
