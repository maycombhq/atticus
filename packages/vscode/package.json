{
  "name": "atticus",
  "displayName": "Atticus",
  "version": "0.1.1",
  "description": "Run Atticus's AI steps with Copilot's own model, in VS Code. Atticus's command line does all the checking.",
  "license": "Apache-2.0",
  "publisher": "maycombhq",
  "private": true,
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#05070a",
    "theme": "dark"
  },
  "keywords": [
    "sdd",
    "spec-driven",
    "architecture",
    "flows",
    "copilot",
    "openspec",
    "catalog",
    "diagrams"
  ],
  "homepage": "https://github.com/maycombhq/atticus/tree/main/packages/vscode#readme",
  "bugs": {
    "url": "https://github.com/maycombhq/atticus/issues"
  },
  "pricing": "Free",
  "qna": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/maycombhq/atticus.git",
    "directory": "packages/vscode"
  },
  "type": "commonjs",
  "main": "./dist/extension.js",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "workspaceContains:org-pack/**",
    "workspaceContains:.atticus/org-pack/**",
    "onStartupFinished"
  ],
  "files": [
    "dist",
    "media",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.shared.mjs --fsModuleCachePath=node_modules/.vitest-cache --testTimeout=60000 --hookTimeout=60000",
    "package": "node scripts/copy-app.mjs && tsc -p tsconfig.build.json && vsce package --no-dependencies",
    "marketplace": "node scripts/copy-app.mjs && tsc -p tsconfig.build.json && vsce publish --no-dependencies",
    "marketplace:pre-release": "node scripts/copy-app.mjs && tsc -p tsconfig.build.json && vsce publish --pre-release --no-dependencies",
    "test:vscode": "tsc -p tsconfig.build.json && node scripts/copy-app.mjs && node scripts/test-in-vscode.mjs"
  },
  "contributes": {
    "chatParticipants": [
      {
        "id": "atticus.chat",
        "name": "atticus",
        "fullName": "Atticus",
        "description": "Run the next Atticus step with Copilot's model",
        "isSticky": true,
        "commands": [
          {
            "name": "new",
            "description": "Start a change: /new <what it is>, then pick its type and write its brief"
          },
          {
            "name": "next",
            "description": "The next step, and a button to run it"
          },
          {
            "name": "survey",
            "description": "Draft a repo's scan settings: /survey <repo>"
          },
          {
            "name": "verify",
            "description": "Compare a repo's code with its last scan: /verify <repo>"
          },
          {
            "name": "spec",
            "description": "Draft a repo's spec, then check it: /spec <repo>"
          },
          {
            "name": "feature",
            "description": "Run a change's feature stage: /feature <change>"
          },
          {
            "name": "architecture",
            "description": "Run a change's architecture stage: /architecture <change>"
          },
          {
            "name": "stories",
            "description": "Write a change's stories and tasks: /stories <change>"
          },
          {
            "name": "answer",
            "description": "The open questions, with a button for each answer"
          },
          {
            "name": "diagram",
            "description": "A repo on the Architecture canvas, or one of its flows: /diagram [repo] [flow]"
          },
          {
            "name": "ask",
            "description": "Ask the catalog a plain question: /ask <question>"
          },
          {
            "name": "run",
            "description": "Any atticus command: /run <command> [arguments] (every command, from atticus commands)"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "atticus.next",
        "title": "Show the next step",
        "category": "Atticus"
      },
      {
        "command": "atticus.runNext",
        "title": "Run the next step",
        "category": "Atticus",
        "icon": "$(play)"
      },
      {
        "command": "atticus.survey",
        "title": "Survey a repo (draft its scan settings)",
        "category": "Atticus"
      },
      {
        "command": "atticus.verify",
        "title": "Verify a repo's last scan",
        "category": "Atticus"
      },
      {
        "command": "atticus.spec",
        "title": "Draft and check a repo's spec",
        "category": "Atticus"
      },
      {
        "command": "atticus.feature",
        "title": "Run a change's feature stage",
        "category": "Atticus"
      },
      {
        "command": "atticus.architecture",
        "title": "Run a change's architecture stage",
        "category": "Atticus"
      },
      {
        "command": "atticus.stories",
        "title": "Write a change's stories",
        "category": "Atticus"
      },
      {
        "command": "atticus.answer",
        "title": "Answer an open question",
        "category": "Atticus"
      },
      {
        "command": "atticus.ask",
        "title": "Ask the catalog a question",
        "category": "Atticus"
      },
      {
        "command": "atticus.showApp",
        "title": "Open the app",
        "category": "Atticus"
      },
      {
        "command": "atticus.diagram",
        "title": "Open a repo on the Architecture canvas",
        "category": "Atticus"
      },
      {
        "command": "atticus.openApp",
        "title": "Open the app in the browser",
        "category": "Atticus"
      },
      {
        "command": "atticus.refresh",
        "title": "Refresh",
        "category": "Atticus",
        "icon": "$(refresh)"
      },
      {
        "command": "atticus.showLog",
        "title": "Show the commands run",
        "category": "Atticus"
      },
      {
        "command": "atticus.openItem",
        "title": "Open",
        "category": "Atticus"
      },
      {
        "command": "atticus.showStep",
        "title": "Show in the diagram",
        "category": "Atticus",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "atticus.showFlow",
        "title": "Open the flow's diagram",
        "category": "Atticus",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "atticus.findingAction",
        "title": "Act on the finding",
        "category": "Atticus",
        "icon": "$(check)"
      },
      {
        "command": "atticus.runCommand",
        "title": "Run a command…",
        "category": "Atticus",
        "icon": "$(terminal)"
      },
      {
        "command": "atticus.newChange",
        "title": "New change",
        "category": "Atticus",
        "icon": "$(add)"
      },
      {
        "command": "atticus.repoCommand",
        "title": "Run on this repo…",
        "category": "Atticus",
        "icon": "$(play)"
      },
      {
        "command": "atticus.changeCommand",
        "title": "Run on this change…",
        "category": "Atticus",
        "icon": "$(play)"
      },
      {
        "command": "atticus.runTask",
        "title": "Run the task",
        "category": "Atticus",
        "icon": "$(play)"
      },
      {
        "command": "atticus.checkHealth",
        "title": "Check this machine and the metarepo",
        "category": "Atticus",
        "icon": "$(pulse)"
      },
      {
        "command": "atticus.scanAll",
        "title": "Scan every repo",
        "category": "Atticus",
        "icon": "$(sync)"
      },
      {
        "command": "atticus.estateJoin",
        "title": "Join the estate's flows",
        "category": "Atticus",
        "icon": "$(link)"
      },
      {
        "command": "atticus.workspaceSync",
        "title": "Clone or update the base clones",
        "category": "Atticus",
        "icon": "$(repo-pull)"
      },
      {
        "command": "atticus.sourcesSync",
        "title": "Sync the knowledge sources",
        "category": "Atticus",
        "icon": "$(cloud-download)"
      },
      {
        "command": "atticus.knowledgeScan",
        "title": "Scan the knowledge sources",
        "category": "Atticus",
        "icon": "$(book)"
      },
      {
        "command": "atticus.knowledgeAsk",
        "title": "Ask the knowledge",
        "category": "Atticus",
        "icon": "$(question)"
      },
      {
        "command": "atticus.upgrade",
        "title": "Upgrade the metarepo",
        "category": "Atticus"
      },
      {
        "command": "atticus.setup",
        "title": "The setup checklist",
        "category": "Atticus"
      },
      {
        "command": "atticus.digest",
        "title": "What waits on you",
        "category": "Atticus"
      },
      {
        "command": "atticus.runApproved",
        "title": "Approve and run",
        "category": "Atticus"
      },
      {
        "command": "atticus.createMetarepo",
        "title": "Create a metarepo",
        "category": "Atticus",
        "icon": "$(new-folder)"
      },
      {
        "command": "atticus.adoptRepo",
        "title": "Use Atticus in this repo",
        "category": "Atticus"
      },
      {
        "command": "atticus.practiceSandbox",
        "title": "Try a practice metarepo",
        "category": "Atticus"
      },
      {
        "command": "atticus.addRepos",
        "title": "Add repos",
        "category": "Atticus",
        "icon": "$(add)"
      },
      {
        "command": "atticus.draftSpec",
        "title": "Draft a repo's spec with Copilot",
        "category": "Atticus"
      },
      {
        "command": "atticus.answerRepo",
        "title": "Answer this repo's questions",
        "category": "Atticus",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "atticus.installCopilot",
        "title": "Install GitHub Copilot Chat",
        "category": "Atticus"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "atticus",
          "title": "Atticus",
          "icon": "media/atticus.svg"
        }
      ]
    },
    "views": {
      "atticus": [
        {
          "id": "atticus.view",
          "name": "Next"
        },
        {
          "id": "atticus.questions",
          "name": "Questions"
        },
        {
          "id": "atticus.repos",
          "name": "Repos"
        },
        {
          "id": "atticus.changes",
          "name": "Changes"
        },
        {
          "id": "atticus.knowledge",
          "name": "Knowledge",
          "visibility": "collapsed"
        },
        {
          "id": "atticus.catalog",
          "name": "Catalog",
          "visibility": "collapsed"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "atticus.refresh",
          "when": "view =~ /^atticus.(view|questions|repos|changes|knowledge|catalog)$/",
          "group": "navigation@9"
        },
        {
          "command": "atticus.runCommand",
          "when": "view == atticus.view",
          "group": "navigation@1"
        },
        {
          "command": "atticus.checkHealth",
          "when": "view == atticus.view",
          "group": "navigation@2"
        },
        {
          "command": "atticus.setup",
          "when": "view == atticus.view",
          "group": "more"
        },
        {
          "command": "atticus.digest",
          "when": "view == atticus.view",
          "group": "more"
        },
        {
          "command": "atticus.upgrade",
          "when": "view == atticus.view",
          "group": "more"
        },
        {
          "command": "atticus.scanAll",
          "when": "view == atticus.repos",
          "group": "navigation@1"
        },
        {
          "command": "atticus.estateJoin",
          "when": "view == atticus.repos",
          "group": "navigation@2"
        },
        {
          "command": "atticus.workspaceSync",
          "when": "view == atticus.repos",
          "group": "more"
        },
        {
          "command": "atticus.newChange",
          "when": "view == atticus.changes",
          "group": "navigation@1"
        },
        {
          "command": "atticus.sourcesSync",
          "when": "view == atticus.knowledge",
          "group": "navigation@1"
        },
        {
          "command": "atticus.knowledgeScan",
          "when": "view == atticus.knowledge",
          "group": "navigation@2"
        },
        {
          "command": "atticus.knowledgeAsk",
          "when": "view == atticus.knowledge",
          "group": "navigation@3"
        },
        {
          "command": "atticus.addRepos",
          "when": "view == atticus.repos",
          "group": "navigation@0"
        }
      ],
      "view/item/context": [
        {
          "command": "atticus.runNext",
          "when": "view == atticus.view && viewItem == atticus.next",
          "group": "inline"
        },
        {
          "command": "atticus.showStep",
          "when": "view == atticus.repos && viewItem == atticus.step",
          "group": "inline"
        },
        {
          "command": "atticus.showFlow",
          "when": "view == atticus.repos && viewItem == atticus.flow",
          "group": "inline"
        },
        {
          "command": "atticus.findingAction",
          "when": "view == atticus.changes && viewItem == atticus.finding",
          "group": "inline"
        },
        {
          "command": "atticus.repoCommand",
          "when": "view == atticus.repos && viewItem == atticus.repo",
          "group": "inline"
        },
        {
          "command": "atticus.repoCommand",
          "when": "view == atticus.repos && viewItem == atticus.repo",
          "group": "atticus"
        },
        {
          "command": "atticus.changeCommand",
          "when": "view == atticus.changes && viewItem == atticus.change",
          "group": "inline"
        },
        {
          "command": "atticus.changeCommand",
          "when": "view == atticus.changes && viewItem == atticus.change",
          "group": "atticus"
        },
        {
          "command": "atticus.runTask",
          "when": "view == atticus.changes && viewItem == atticus.task",
          "group": "inline"
        },
        {
          "command": "atticus.answerRepo",
          "when": "view == atticus.questions && viewItem == atticus.questionRepo",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "atticus.openItem",
          "when": "false"
        },
        {
          "command": "atticus.showStep",
          "when": "false"
        },
        {
          "command": "atticus.showFlow",
          "when": "false"
        },
        {
          "command": "atticus.findingAction",
          "when": "false"
        },
        {
          "command": "atticus.runApproved",
          "when": "false"
        },
        {
          "command": "atticus.repoCommand",
          "when": "false"
        },
        {
          "command": "atticus.changeCommand",
          "when": "false"
        },
        {
          "command": "atticus.runTask",
          "when": "false"
        },
        {
          "command": "atticus.answerRepo",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Atticus",
      "properties": {
        "atticus.path": {
          "type": "string",
          "default": "atticus",
          "markdownDescription": "The `atticus` command line: a command on your PATH (default `atticus`), or the full path to it or to its `bin.js`."
        },
        "atticus.model": {
          "type": "string",
          "default": "",
          "markdownDescription": "The Copilot model family to use (for example `gpt-4o`). Empty: the model picked in Copilot Chat, or else the first Copilot model available."
        },
        "atticus.codeLens": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show, above each line of code a spec flow cites, which flow and step cite it. Click one to open the flow."
        },
        "atticus.codeLens.records": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "With `atticus.codeLens` on, also show which catalog records (endpoints, tables, interfaces…) were read from a line."
        },
        "atticus.appIn": {
          "type": "string",
          "enum": [
            "panel",
            "frame"
          ],
          "default": "panel",
          "markdownDescription": "How the Atticus tab shows the app. `panel`: from the extension's own files, its calls answered through the local API (works where framing a local page is blocked, and over SSH or in a container). `frame`: the page `atticus ui` serves on 127.0.0.1, framed."
        },
        "atticus.showDeveloperCommands": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Show, in Run a command, the commands only Atticus's own developers use (bench, eval, plugin test, conformance)."
        }
      }
    },
    "viewsWelcome": [
      {
        "view": "atticus.view",
        "when": "atticus.cliMissing",
        "contents": "Atticus needs its command line, `atticus`, on this machine.\n[How to install it](https://github.com/maycombhq/atticus/blob/main/docs/guide/install.md)\n[Set its path](command:workbench.action.openSettings?%5B%22atticus.path%22%5D)\n[Check again](command:atticus.checkHealth)"
      },
      {
        "view": "atticus.view",
        "when": "!atticus.cliMissing && !atticus.hasMetarepo",
        "contents": "No Atticus metarepo is open in this window. A metarepo holds what Atticus knows about your systems and changes.\n[Open a metarepo](command:vscode.openFolder)\n[Create a metarepo](command:atticus.createMetarepo)\n[Use Atticus in this repo](command:atticus.adoptRepo)\n[Try a practice metarepo](command:atticus.practiceSandbox)\nNew to Atticus? [Get started](command:workbench.action.openWalkthrough?%22maycombhq.atticus%23atticus.start%22)."
      },
      {
        "view": "atticus.questions",
        "when": "atticus.cliMissing || !atticus.hasMetarepo",
        "contents": "Open or create a metarepo first: the Next section says how."
      },
      {
        "view": "atticus.repos",
        "when": "atticus.cliMissing || !atticus.hasMetarepo",
        "contents": "Open or create a metarepo first: the Next section says how."
      },
      {
        "view": "atticus.changes",
        "when": "atticus.cliMissing || !atticus.hasMetarepo",
        "contents": "Open or create a metarepo first: the Next section says how."
      },
      {
        "view": "atticus.knowledge",
        "when": "atticus.cliMissing || !atticus.hasMetarepo",
        "contents": "Open or create a metarepo first: the Next section says how."
      },
      {
        "view": "atticus.catalog",
        "when": "atticus.cliMissing || !atticus.hasMetarepo",
        "contents": "Open or create a metarepo first: the Next section says how."
      }
    ],
    "walkthroughs": [
      {
        "id": "atticus.start",
        "title": "Get started with Atticus",
        "description": "From an empty machine to a change planned on your own flows.",
        "steps": [
          {
            "id": "cli",
            "title": "Install the command line",
            "description": "Atticus's work happens in `atticus`; the extension runs it.\n[Check again](command:atticus.checkHealth)",
            "media": {
              "markdown": "media/walkthrough/1-cli.md"
            },
            "completionEvents": [
              "onContext:!atticus.cliMissing"
            ]
          },
          {
            "id": "copilot",
            "title": "Install GitHub Copilot Chat",
            "description": "The AI steps run with Copilot's model.\n[Install Copilot Chat](command:atticus.installCopilot)",
            "media": {
              "markdown": "media/walkthrough/2-copilot.md"
            },
            "completionEvents": [
              "onContext:atticus.copilotOk"
            ]
          },
          {
            "id": "metarepo",
            "title": "Open or create a metarepo",
            "description": "Where Atticus keeps what it knows.\n[Open a metarepo](command:vscode.openFolder)\n[Create a metarepo](command:atticus.createMetarepo)\n[Try a practice metarepo](command:atticus.practiceSandbox)",
            "media": {
              "markdown": "media/walkthrough/3-metarepo.md"
            },
            "completionEvents": [
              "onContext:atticus.hasMetarepo"
            ]
          },
          {
            "id": "repos",
            "title": "Add your repos",
            "description": "Find them in a folder of clones or a Git host organisation.\n[Add repos](command:atticus.addRepos)\n[Clone or update them](command:atticus.workspaceSync)",
            "media": {
              "markdown": "media/walkthrough/4-repos.md"
            },
            "completionEvents": [
              "onCommand:atticus.addRepos",
              "onCommand:atticus.workspaceSync"
            ]
          },
          {
            "id": "scan",
            "title": "Scan the repos",
            "description": "Read the code into the catalog.\n[Scan every repo](command:atticus.scanAll)",
            "media": {
              "markdown": "media/walkthrough/5-scan.md"
            },
            "completionEvents": [
              "onCommand:atticus.scanAll"
            ]
          },
          {
            "id": "specs",
            "title": "Draft the specs",
            "description": "Each repo's flows, step by step, with Copilot.\n[Draft a spec](command:atticus.draftSpec)\n[See the diagrams](command:atticus.showApp)",
            "media": {
              "markdown": "media/walkthrough/6-specs.md"
            },
            "completionEvents": [
              "onCommand:atticus.draftSpec"
            ]
          },
          {
            "id": "change",
            "title": "Start a change",
            "description": "Plan it on the flows, with the critic at every stage.\n[New change](command:atticus.newChange)",
            "media": {
              "markdown": "media/walkthrough/7-change.md"
            },
            "completionEvents": [
              "onCommand:atticus.newChange"
            ]
          }
        ]
      }
    ],
    "keybindings": [
      {
        "command": "atticus.runCommand",
        "key": "ctrl+alt+shift+a",
        "mac": "cmd+alt+shift+a"
      },
      {
        "command": "atticus.runNext",
        "key": "ctrl+alt+shift+n",
        "mac": "cmd+alt+shift+n",
        "when": "atticus.hasMetarepo"
      },
      {
        "command": "atticus.showApp",
        "key": "ctrl+alt+shift+d",
        "mac": "cmd+alt+shift+d",
        "when": "atticus.hasMetarepo"
      }
    ]
  },
  "devDependencies": {
    "@maycombhq/cli": "workspace:*",
    "@types/vscode": "1.95.0",
    "@vscode/vsce": "4.0.0"
  }
}
