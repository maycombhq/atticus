    "viewsContainers": {
      "activitybar": [
        {
          "id": "atticus",
          "title": "Atticus",
          "icon": "media/atticus.svg"
        }
      ]
    },
    "views": {
      "atticus": [
        {
          "id": "atticus.view",
          "name": "Next",
          "initialSize": 4
        },
        {
          "id": "atticus.questions",
          "name": "Waiting on you",
          "when": "atticus.hasMetarepo && !atticus.cliMissing",
          "initialSize": 3
        },
        {
          "id": "atticus.changes",
          "name": "Changes",
          "when": "atticus.hasMetarepo && !atticus.cliMissing",
          "initialSize": 2
        },
        {
          "id": "atticus.knowledge",
          "name": "Knowledge",
          "visibility": "collapsed",
          "when": "atticus.hasMetarepo && !atticus.cliMissing",
          "initialSize": 1
        },
        {
          "id": "atticus.repos",
          "name": "Repos",
          "when": "atticus.hasMetarepo && !atticus.cliMissing",
          "initialSize": 3
        },
        {
          "id": "atticus.catalog",
          "name": "Catalog",
          "visibility": "collapsed",
          "when": "atticus.hasMetarepo && !atticus.cliMissing",
          "initialSize": 1
        },
        {
          "id": "atticus.runs",
          "name": "Model runs",
          "visibility": "collapsed",
          "when": "atticus.hasMetarepo && !atticus.cliMissing",
          "initialSize": 1
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "submenu": "atticus.start",
          "when": "view == atticus.view",
          "group": "navigation@0"
        },
        {
          "command": "atticus.refresh",
          "when": "view =~ /^atticus.(view|questions|repos|changes|knowledge|catalog|runs)$/",
          "group": "navigation@9"
        },
        {
          "command": "atticus.waitingByKind",
          "when": "view == atticus.questions && atticus.waitingGroup != kind",
          "group": "navigation@6"
        },
        {
          "command": "atticus.waitingByChange",
          "when": "view == atticus.questions && atticus.waitingGroup == kind",
          "group": "navigation@6"
        },
        {
          "command": "atticus.filterWaiting",
          "when": "view == atticus.questions",
          "group": "navigation@7"
        },
        {
          "command": "atticus.clearFilterWaiting",
          "when": "view == atticus.questions && atticus.filtered.questions",
          "group": "navigation@8"
        },
        {
          "command": "atticus.filterChanges",
          "when": "view == atticus.changes",
          "group": "navigation@7"
        },
        {
          "command": "atticus.clearFilterChanges",
          "when": "view == atticus.changes && atticus.filtered.changes",
          "group": "navigation@8"
        },
        {
          "command": "atticus.filterKnowledge",
          "when": "view == atticus.knowledge",
          "group": "navigation@7"
        },
        {
          "command": "atticus.clearFilterKnowledge",
          "when": "view == atticus.knowledge && atticus.filtered.knowledge",
          "group": "navigation@8"
        },
        {
          "command": "atticus.filterRuns",
          "when": "view == atticus.runs",
          "group": "navigation@7"
        },
        {
          "command": "atticus.clearFilterRuns",
          "when": "view == atticus.runs && atticus.filtered.runs",
          "group": "navigation@8"
        },
        {
          "command": "atticus.runCommand",
          "when": "view == atticus.view",
          "group": "navigation@1"
        },
        {
          "command": "atticus.checkHealth",
          "when": "view == atticus.view",
          "group": "navigation@2"
        },
        {
          "command": "atticus.setup",
          "when": "view == atticus.view",
          "group": "more"
        },
        {
          "command": "atticus.digest",
          "when": "view == atticus.view",
          "group": "more"
        },
        {
          "command": "atticus.upgrade",
          "when": "view == atticus.view",
          "group": "more"
        },
        {
          "command": "atticus.scanAll",
          "when": "view == atticus.repos",
          "group": "navigation@1"
        },
        {
          "command": "atticus.estateJoin",
          "when": "view == atticus.repos",
          "group": "navigation@2"
        },
        {
          "command": "atticus.workspaceSync",
          "when": "view == atticus.repos",
          "group": "more@2"
        },
        {
          "command": "atticus.newChange",
          "when": "view == atticus.changes",
          "group": "navigation@1"
        },
        {
          "command": "atticus.addRepos",
          "when": "view == atticus.repos",
          "group": "navigation@0"
        },
        {
          "command": "atticus.onboardRepo",
          "when": "view == atticus.repos",
          "group": "more@1"
        },
        {
          "command": "atticus.absorb",
          "when": "view == atticus.repos",
          "group": "more@3"
        },
        {
          "command": "atticus.addWiki",
          "when": "view == atticus.knowledge",
          "group": "navigation@0"
        },
        {
          "command": "atticus.searchWikis",
          "when": "view == atticus.knowledge",
          "group": "navigation@1"
        },
        {
          "command": "atticus.knowledgeScan",
          "when": "view == atticus.knowledge",
          "group": "navigation@2"
        },
        {
          "command": "atticus.sourcesSync",
          "when": "view == atticus.knowledge",
          "group": "navigation@3"
        },
        {
          "command": "atticus.knowledgeAsk",
          "when": "view == atticus.knowledge",
          "group": "1_read@1"
        },
        {
          "command": "atticus.keepFound",
          "when": "view == atticus.knowledge",
          "group": "1_read@2"
        },
        {
          "command": "atticus.raiseNeeds",
          "when": "view == atticus.changes",
          "group": "more@1"
        },
        {
          "command": "atticus.draftOrgPack",
          "when": "view == atticus.knowledge",
          "group": "3_orgpack@1"
        },
        {
          "command": "atticus.reviewUnverified",
          "when": "view == atticus.knowledge",
          "group": "2_review@1"
        },
        {
          "command": "atticus.ask",
          "when": "view == atticus.catalog",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "atticus.runStep",
          "when": "view == atticus.view && viewItem == atticus.next",
          "group": "inline"
        },
