{
  "name": "@maycombhq/intake",
  "version": "2.0.0-beta.1",
  "description": "Takes in whatever is dropped into inputs/: classifies, dedupes and versions each file, reads partner specs and payload samples, and builds the triage list of what a person must decide.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.shared.mjs --fsModuleCachePath=node_modules/.vitest-cache --testTimeout=30000"
  },
  "dependencies": {
    "@maycombhq/ai": "workspace:*",
    "@maycombhq/core": "workspace:*",
    "@maycombhq/extractors": "workspace:*",
    "@maycombhq/ingestors": "workspace:*",
    "@maycombhq/reconcile": "workspace:*",
    "@maycombhq/sdk": "workspace:*",
    "yaml": "^2.9.1"
  },
  "devDependencies": {},
  "publishConfig": {
    "access": "public"
  }
}
