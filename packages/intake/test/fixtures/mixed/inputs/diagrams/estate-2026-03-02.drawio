<mxfile host="drawio">
  <diagram id="p1" name="Estate">
    <mxGraphModel>
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="hub" value="Billing Hub" vertex="1" parent="1"/>
        <mxCell id="fx" value="Fabrikam FX" vertex="1" parent="1"/>
        <mxCell id="ledger" value="Ledger Platform" vertex="1" parent="1"/>
        <mxCell id="tax" value="Tax Engine" vertex="1" parent="1"/>
        <mxCell id="e1" value="GET /v2/rates/{pair}" edge="1" source="hub" target="fx" parent="1"/>
        <mxCell id="e2" value="POST /entries" edge="1" source="hub" target="ledger" parent="1"/>
        <mxCell id="e3" value="POST /tax" edge="1" source="hub" target="tax" parent="1"/>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
