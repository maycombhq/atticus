{
  "name": "@maycombhq/scanner",
  "version": "1.0.0-rc.1",
  "description": "Runs every extractor and dialect over every repo, merges the results into one catalog, and writes and diffs catalog files.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.shared.mjs --fsModuleCachePath=node_modules/.vitest-cache --testTimeout=30000 --hookTimeout=60000"
  },
  "dependencies": {
    "@maycombhq/core": "workspace:*",
    "@maycombhq/extractors": "workspace:*",
    "@maycombhq/features": "workspace:*",
    "@maycombhq/glossary": "workspace:*",
    "@maycombhq/ingestors": "workspace:*",
    "@maycombhq/intake": "workspace:*",
    "@maycombhq/sdk": "workspace:*",
    "@maycombhq/workspace": "workspace:*"
  },
  "devDependencies": {
    "@maycombhq/index": "workspace:*",
    "@maycombhq/synth": "workspace:*",
    "yaml": "^2.9.1"
  }
}
