{
  "name": "@maycombhq/assistant-files",
  "version": "2.0.0-beta.8",
  "private": true,
  "description": "Copilot and Claude Code files (instructions, prompts, commands, agents, skills, Spec Kit commands) generated from the org pack's one skill source.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.shared.mjs --fsModuleCachePath=node_modules/.vitest-cache --testTimeout=30000"
  },
  "dependencies": {
    "@maycombhq/core": "workspace:*",
    "@maycombhq/workspace": "workspace:*",
    "yaml": "^2.9.1",
    "zod": "^4.6.0"
  }
}
