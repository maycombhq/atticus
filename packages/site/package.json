{
  "name": "@maycombhq/site",
  "version": "2.0.0-beta.8",
  "private": true,
  "description": "System guides generated from the catalog, and the read-only catalog site: static files with only the systems open to everyone.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.shared.mjs --fsModuleCachePath=node_modules/.vitest-cache --testTimeout=30000 --hookTimeout=60000"
  },
  "dependencies": {
    "@maycombhq/core": "workspace:*"
  },
  "devDependencies": {
    "yaml": "^2.9.1"
  }
}
