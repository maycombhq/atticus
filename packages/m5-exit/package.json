{
  "name": "@maycombhq/m5-exit",
  "version": "0.0.0",
  "private": true,
  "description": "The M5 exit check: performance budgets on a synthetic estate three times the target size, and the installed command line's start time.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --fsModuleCachePath=node_modules/.vitest-cache --testTimeout=600000 --hookTimeout=600000"
  },
  "dependencies": {
    "@maycombhq/cli": "workspace:*",
    "@maycombhq/core": "workspace:*",
    "@maycombhq/scanner": "workspace:*",
    "@maycombhq/synth": "workspace:*",
    "@maycombhq/ui": "workspace:*"
  }
}
