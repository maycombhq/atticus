{
  "name": "@maycombhq/changes",
  "version": "2.0.0-beta.9",
  "private": true,
  "description": "The change lifecycle: change state, change types and templates, hand-off PRs, separation of duties, privacy impact, risk scoring, test strategy and conflict detection.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.shared.mjs --fsModuleCachePath=node_modules/.vitest-cache --testTimeout=120000"
  },
  "dependencies": {
    "@maycombhq/adapters": "workspace:*",
    "@maycombhq/core": "workspace:*",
    "@maycombhq/openspec-adapter": "workspace:*",
    "@maycombhq/scanner": "workspace:*",
    "@maycombhq/workspace": "workspace:*",
    "yaml": "^2.9.1",
    "zod": "^4.6.0"
  }
}
