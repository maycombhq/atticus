      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@maycombhq/core": "workspace:*",
    "@maycombhq/sdk": "workspace:*",
    "yaml": "^2.9.1",
    "zod": "^4.6.0"
  }
}
