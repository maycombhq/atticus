{
  "name": "@maycombhq/extractors",
  "version": "2.0.0-beta.9",
  "private": true,
  "description": "Atticus's built-in extractors: OpenAPI, Apigee-style gateways, Spring, frontend calls, topic configs and SQL migrations.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "dialects",
    "grammars"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.shared.mjs --fsModuleCachePath=node_modules/.vitest-cache --testTimeout=30000 --hookTimeout=60000"
  },
  "dependencies": {
    "@maycombhq/core": "workspace:*",
    "@maycombhq/sdk": "workspace:*",
    "tree-sitter-wasms": "0.1.13",
    "web-tree-sitter": "0.22.6",
    "yaml": "^2.9.1",
    "zod": "^4.6.0"
  }
}
