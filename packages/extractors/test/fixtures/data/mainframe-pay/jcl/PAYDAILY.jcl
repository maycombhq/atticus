//PAYDAILY JOB (ACCT01),'DAILY PAYROLL',CLASS=A,MSGCLASS=X
//*  Daily payroll run for the Forge pay system
//JOBLIB   DD DSN=FORGE.PAY.LOADLIB,DISP=SHR
//STEP010  EXEC PGM=PAYEXTR
//INFILE   DD DSN=FORGE.PAY.TIMECARD,DISP=SHR
//OUTFILE  DD DSN=FORGE.PAY.EXTRACT(+1),
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(5,5)),UNIT=SYSDA
//SYSOUT   DD SYSOUT=*
//STEP020  EXEC PGM=PAYCALC,PARM='DAILY'
//EXTRACT  DD DSN=FORGE.PAY.EXTRACT(0),DISP=SHR
//LEDGER   DD DSN=FORGE.PAY.LEDGER,DISP=OLD
//MASTER   DD DSNAME=FORGE.PAY.MASTER,DISP=(MOD,KEEP)
//WORK     DD DSN=&&TEMP,DISP=(NEW,PASS)
//STEP030  EXEC PAYRPT
//REPORT   DD SYSOUT=A
