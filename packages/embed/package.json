{
  "name": "@maycombhq/embed",
  "version": "2.0.0-beta.9",
  "private": true,
  "description": "The local embedding model (ADR 0116): a small ONNX text model run on the person's own machine with onnxruntime-node (or its WASM build), a WordPiece tokenizer, and the model manifest. Nothing is downloaded.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.shared.mjs --fsModuleCachePath=node_modules/.vitest-cache --testTimeout=60000 --hookTimeout=60000"
  },
  "dependencies": {
    "@maycombhq/ai": "workspace:*",
    "@maycombhq/core": "workspace:*",
    "@maycombhq/embed-model": "workspace:*",
    "yaml": "^2.9.1",
    "zod": "^4.6.0"
  },
  "optionalDependencies": {
    "@maycombhq/onnxruntime-darwin-arm64": "workspace:*",
    "@maycombhq/onnxruntime-linux-arm64": "workspace:*",
    "@maycombhq/onnxruntime-linux-x64": "workspace:*",
    "@maycombhq/onnxruntime-wasm": "workspace:*",
    "@maycombhq/onnxruntime-win32-arm64": "workspace:*",
    "@maycombhq/onnxruntime-win32-x64": "workspace:*"
  }
}
