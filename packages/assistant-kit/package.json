{
  "name": "@maycombhq/assistant-kit",
  "version": "2.0.0-beta.1",
  "description": "The dialect build kit an organisation's own assistant uses to write dialects, dialect scaffolding and testing, and the kit's evaluation grader.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "kit",
    "frameworks-kit"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.shared.mjs --fsModuleCachePath=node_modules/.vitest-cache --testTimeout=30000"
  },
  "dependencies": {
    "@maycombhq/ai": "workspace:*",
    "@maycombhq/core": "workspace:*",
    "@maycombhq/extractors": "workspace:*",
    "@maycombhq/scanner": "workspace:*",
    "@maycombhq/sdk": "workspace:*",
    "yaml": "^2.9.1",
    "zod": "^4.6.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
