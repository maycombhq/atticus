{
  "name": "@maycombhq/adapters",
  "version": "1.0.0-rc.1",
  "description": "Atticus adapters for outside systems (work tracker, service desk, Git host, wiki, notifications, design tool), each with an in-memory mock.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --fsModuleCachePath=node_modules/.vitest-cache --testTimeout=30000 --hookTimeout=60000"
  },
  "dependencies": {
    "@maycombhq/core": "workspace:*",
    "zod": "^4.6.0",
    "yaml": "^2.9.1"
  }
}
