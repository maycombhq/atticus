{
  "name": "@maycombhq/diagrams",
  "version": "2.0.0-beta.1",
  "description": "Renders catalog views (context, container, data, event, sequence) as Mermaid and draw.io, and a draw.io shape library.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.shared.mjs --fsModuleCachePath=node_modules/.vitest-cache --testTimeout=30000"
  },
  "dependencies": {
    "@maycombhq/core": "workspace:*",
    "@maycombhq/reconcile": "workspace:*"
  },
  "devDependencies": {
    "yaml": "^2.9.1"
  }
}
