{
  "name": "@maycombhq/conformance",
  "version": "2.0.0-beta.1",
  "description": "The conformance suite for the Atticus specification: checks a catalog folder, an org pack, a dialect, a plugin extractor or ingestor, or a step executor against contracts C1-C6; and the generator of the published spec pages.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "sample"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.shared.mjs --fsModuleCachePath=node_modules/.vitest-cache --testTimeout=120000"
  },
  "dependencies": {
    "@maycombhq/core": "workspace:*",
    "@maycombhq/executors": "workspace:*",
    "@maycombhq/extractors": "workspace:*",
    "@maycombhq/sdk": "workspace:*",
    "yaml": "^2.9.1",
    "zod": "^4.6.0"
  }
}
