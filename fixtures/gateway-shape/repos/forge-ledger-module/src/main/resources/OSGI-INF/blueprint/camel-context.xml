<?xml version="1.0" encoding="UTF-8"?>
<blueprint xmlns="http://www.osgi.org/xmlns/blueprint/v1.0.0">
  <camelContext id="ledger" xmlns="http://camel.apache.org/schema/blueprint">
    <restConfiguration component="servlet" contextPath="/cxf/api" bindingMode="json"/>
    <rest path="/accounts">
      <get uri="/{accountId}">
        <to uri="direct:getLedgerAccount"/>
      </get>
      <get uri="/{accountId}/blocks">
        <to uri="direct:listLedgerBlocks"/>
      </get>
    </rest>
    <rest path="/statements">
      <get uri="/{statementId}">
        <to uri="direct:getStatement"/>
      </get>
    </rest>
    <route id="getLedgerAccount">
      <from uri="direct:getLedgerAccount"/>
      <to uri="sql:select * from ledger_account where id = :#${header.accountId}"/>
    </route>
    <route id="listLedgerBlocks">
      <from uri="direct:listLedgerBlocks"/>
      <to uri="sql:select * from ledger_block where account_id = :#${header.accountId}"/>
    </route>
    <route id="getStatement">
      <from uri="direct:getStatement"/>
      <to uri="sql:select * from ledger_statement where id = :#${header.statementId}"/>
    </route>
  </camelContext>
</blueprint>
