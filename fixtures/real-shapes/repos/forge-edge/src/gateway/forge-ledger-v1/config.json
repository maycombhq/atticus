{
    "configurations": [
        {
            "name": "test",
            "policies": [
                {
                    "name": "AM-Set-Headers.xml",
                    "tokens": [
                        {
                            "xpath": "/AssignMessage/Set/Headers/Header[@name='x-forge-env']",
                            "value": "test"
                        }
                    ]
                },
                {
                    "name": "BA-Backend.xml",
                    "tokens": [
                        {
                            "xpath": "/BasicAuthentication/Password",
                            "value": "Ledg3r-Backend-Pa55-test"
                        }
                    ]
                }
            ],
            "proxies": [
                {
                    "name": "default.xml",
                    "tokens": [
                        {
                            "xpath": "/ProxyEndpoint/HTTPProxyConnection/BasePath",
                            "value": "/forge/ledger/v1"
                        }
                    ]
                }
            ],
            "targets": [
                {
                    "name": "default.xml",
                    "tokens": [
                        {
                            "xpath": "/TargetEndpoint/HTTPTargetConnection/URL",
                            "value": "https://ledger.test.forge.example/ledger"
                        }
                    ]
                }
            ]
        },
        {
            "name": "prod",
            "policies": [
                {
                    "name": "AM-Set-Headers.xml",
                    "tokens": [
                        {
                            "value": "prod",
                            "xpath": "/AssignMessage/Set/Headers/Header[@name='x-forge-env']"
                        }
                    ]
                }
            ],
            "proxies": [
                {
                    "name": "default.xml",
                    "tokens": [
                        {
                            "xpath": "/ProxyEndpoint/HTTPProxyConnection/BasePath",
                            "value": "/forge/ledger/v1"
                        }
                    ]
                }
            ],
            "targets": [
                {
                    "name": "default.xml",
                    "tokens": [
                        {
                            "xpath": "/TargetEndpoint/HTTPTargetConnection/URL",
                            "value": "https://ledger.forge.example/ledger"
                        }
                    ]
                }
            ]
        }
    ]
}
