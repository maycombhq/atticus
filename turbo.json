{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["vitest.shared.mjs", "scripts/vitest-temp.mjs"],
  "globalPassThroughEnv": ["ATTICUS_DIAG", "ATTICUS_DIAG_FILE", "ATTICUS_DIAG_MIN"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.base.json", "$TURBO_ROOT$/scripts/**"],
      "outputs": ["dist/**", "dist-lib/**", "npm/**", "THIRD-PARTY-LICENSES.txt"]
    },
    "@maycombhq/atticus#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/scripts/**",
        "$TURBO_ROOT$/LICENSE",
        "$TURBO_ROOT$/fixtures/forge/**",
        "$TURBO_ROOT$/fixtures/forge-change/**"
      ],
      "outputs": ["dist/**", "THIRD-PARTY-LICENSES.txt", "LICENSE"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    }
  }
}
