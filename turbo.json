{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["vitest.shared.mjs", "scripts/vitest-temp.mjs"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "dist-lib/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    }
  }
}
