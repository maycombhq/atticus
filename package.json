{
  "name": "atticus-monorepo",
  "private": true,
  "description": "Atticus: map a multi-repo ecosystem from its code and run every change from idea to release, with an AI critic and human approvals.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint . && prettier --check . && node scripts/check-core-neutral.mjs && node scripts/check-portable-paths.mjs && node scripts/check-deps.mjs && node scripts/check-docs.mjs && node scripts/bundle/check-licences.mjs",
    "format": "prettier --write .",
    "denylist": "node scripts/check-denylist.mjs",
    "check": "pnpm denylist && pnpm lint && pnpm typecheck && pnpm test",
    "api:doc": "pnpm --filter @maycombhq/core build && node scripts/write-api-doc.mjs",
    "spec:doc": "pnpm --filter @maycombhq/conformance... build && node scripts/write-spec.mjs",
    "bundle": "node scripts/bundle/offline-bundle.mjs",
    "bundle:test": "node scripts/bundle/test-bundle.mjs",
    "licences": "node scripts/bundle/check-licences.mjs",
    "docs:commands": "node scripts/write-command-doc.mjs",
    "claude-plugin": "node scripts/write-claude-plugin.mjs",
    "copilot-agents": "node scripts/write-copilot-agents.mjs",
    "model:fetch": "node scripts/model/fetch.mjs --all",
    "model:pins": "node scripts/model/write-pins.mjs",
    "release:npm": "node scripts/release-npm.mjs",
    "release:npm:deprecate": "node scripts/release-npm-deprecate.mjs",
    "npm:test": "node scripts/bundle/test-npm-install.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.10.0",
    "esbuild": "0.28.2",
    "eslint": "^10.0.0",
    "prettier": "^3.9.0",
    "turbo": "^2.11.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.0"
  }
}
