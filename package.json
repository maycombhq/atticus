{
  "name": "atticus-monorepo",
  "private": true,
  "description": "Atticus: map a multi-repo ecosystem from its code and run every change from idea to release, with an AI critic and human approvals.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "denylist": "node scripts/check-denylist.mjs",
    "check": "pnpm denylist && pnpm lint && pnpm typecheck && pnpm test",
    "api:doc": "pnpm --filter @maycombhq/core build && node scripts/write-api-doc.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.10.0",
    "eslint": "^10.0.0",
    "prettier": "^3.9.0",
    "turbo": "^2.11.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.0"
  }
}
